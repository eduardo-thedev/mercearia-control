# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (bate com o docker-compose.yml)
DATABASE_URL=postgresql://mercearia:mercearia@localhost:5432/mercearia_db

# Auth
JWT_SECRET=troque-isso-por-um-segredo-forte-antes-de-subir-pra-producao
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://192.168.15.11:5173/login

# E-mail (recuperacao de senha) - opcional em dev: sem RESEND_API_KEY,
# o link de reset cai no console do backend em vez de ser enviado.
RESEND_API_KEY=
EMAIL_FROM=Mercearia Lima <onboarding@resend.dev>
